rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mfoysalalom7@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.languagePreference in ['auto', 'bn', 'en'] &&
             data.role in ['user', 'admin'] &&
             data.status in ['active', 'suspended'] &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.category is string && data.category.size() <= 50 &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidConversation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 20000 &&
             data.detectedLanguage is string && data.detectedLanguage.size() <= 50 &&
             data.mode in ['voice', 'chat', 'coding'];
    }

    function isValidAppStats(data) {
      return data.totalUsers is number && data.totalUsers >= 0 &&
             data.totalConversations is number && data.totalConversations >= 0 &&
             data.systemHealth is string && data.systemHealth.size() <= 100 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'languagePreference', 'role', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoUrl', 'languagePreference', 'role', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       (incoming().role == 'user' || isAdmin()) &&
                       incoming().status == 'active' &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) && (
                         // Regular user profile update
                         (request.auth.uid == userId &&
                          incoming().userId == existing().userId &&
                          incoming().email == existing().email &&
                          incoming().role == existing().role &&
                          incoming().status == existing().status &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'languagePreference', 'updatedAt'])) ||
                         // Admin management update
                         (isAdmin() &&
                          incoming().userId == existing().userId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'languagePreference', 'role', 'status', 'updatedAt']))
                       );

      allow delete: if isAdmin();

      // User Personal Memories
      match /memories/{memoryId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(memoryId) &&
                         incoming().id == memoryId &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'content', 'category', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'content', 'category', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMemory(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(memoryId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'updatedAt']) &&
                         isValidMemory(incoming());

        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // User Conversations History
      match /conversations/{conversationId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(conversationId) &&
                         incoming().id == conversationId &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'role', 'content', 'detectedLanguage', 'mode', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'role', 'content', 'detectedLanguage', 'mode', 'createdAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidConversation(incoming());

        allow update: if false; // Immutable conversation logs
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // System overview and analytics
    match /app_stats/{statId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }
  }
}
